{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Skill",
      "Edit(backend/tests/**)",
      "Write(backend/tests/**)",
      "Edit(frontend/src/**/*.test.ts)",
      "Edit(frontend/src/**/*.test.tsx)",
      "Write(frontend/src/**/*.test.ts)",
      "Write(frontend/src/**/*.test.tsx)",
      "Edit(frontend/src/test/**)",
      "Write(frontend/src/test/**)",
      "Write(.agent-output/**)",
      "Edit(.agent-output/**)",
      "Bash(node .claude/skills/*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git status:*)"
    ],
    "deny": [
      "WebFetch",
      "WebSearch",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Edit(.github/**)",
      "Write(.github/**)",
      "Edit(backend/src/**)",
      "Write(backend/src/**)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(npm install:*)",
      "Bash(git push:*)",
      "Bash(git commit:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-tool-use.mjs\"", "timeout": 10 }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1"
  }
}
